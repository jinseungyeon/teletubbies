# Separately deployed fe application, including its login path.
VITE_APP_URL=
# Optional absolute URL accepting POST multipart/form-data from the landing origin.
# Fields: company, name, email, size, msg, attachment (optional).
# Any 2xx response means accepted; configure CORS on the receiving server.
# Leave blank to offer an email draft; the site will never claim it was submitted.
VITE_CONTACT_ENDPOINT=
